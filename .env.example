# No host (npm run dev). Dentro do Compose a URL aponta para o serviço db.
# Dados deste produto. O perfil (papel, departamento, estado) vive aqui.
DATABASE_URL=postgresql://utilizador:password@host:5432/next_pumangol_onboarding
# Identidade partilhada (better-auth). O mesmo id liga as duas bases.
# Local, contentor pumangol_auth: postgresql://pumangol:pumangol@localhost:5434/pumangol_auth
AUTH_DATABASE_URL=postgresql://utilizador:password@host:5432/next_pumangol_auth
AUTH_JWT_SECRET=substituir-por-openssl-rand-hex-32

# Serviço de Ficheiros Pumangol. A chave fica só no servidor — nunca em NEXT_PUBLIC_ nem no frontend.
# Registar a aplicação uma vez (code peopleconnect) e pôr a apiKey aqui.
# allowedOrigins tem de incluir a origem exacta do site (ex.: http://localhost:3000 e o domínio de produção),
# porque o browser envia o ficheiro directamente para o serviço.
# Tipos: image/jpeg, image/png, image/webp, application/pdf,
# application/msword, application/vnd.openxmlformats-officedocument.wordprocessingml.document,
# application/vnd.ms-excel, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.
# maxFileSizeBytes: 20971520 (20 MB).
FILE_SERVICE_URL=https://portal.pumangol.co.ao/ficheiros
FILE_SERVICE_APP_ID=
FILE_SERVICE_API_KEY=

# Ficheiros antigos (fotos e documentos já gravados) num bucket S3.
# Local: contentor pumangol_minio (docker compose up -d minio minio_init), consola em http://localhost:9001.
# Os envios novos não usam este bucket.
S3_ENDPOINT=http://localhost:9000
# Endereço que o browser usa para enviar e abrir ficheiros, se for diferente de S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=pumangol-ficheiros
S3_ACCESS_KEY_ID=pumangol
S3_SECRET_ACCESS_KEY=pumangol-minio
S3_FORCE_PATH_STYLE=true
